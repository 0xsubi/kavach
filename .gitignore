# Dart/Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Libraries under packages/ leave their lockfile out; deployable apps pin
# theirs. extension/flutter_popup is an app too — it just ships inside the
# extension rather than living under apps/.
pubspec.lock
!apps/**/pubspec.lock
!extension/flutter_popup/pubspec.lock
*.g.dart
*.freezed.dart
packages/native/**/.build/

# melos
pubspec_overrides.yaml

# iOS/macOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/macos/Pods/
**/macos/Flutter/ephemeral/
*.xcuserstate
xcuserdata/

# Android
**/android/.gradle/
**/android/local.properties
**/android/gradlew
**/android/gradlew.bat
*.jks
*.keystore

# Web / extension
# Matches extension/shell/dist/ (the unpacked extension the build emits) at
# any depth — a bare `extension/dist/` silently matched nothing.
extension/**/dist/
node_modules/
extension/flutter_popup/build/

# IDE
.idea/
.vscode/
*.iml

# OS cruft
# Was only ignored inside apps/*/ via the Flutter template's own .gitignore,
# so one dropped at the repo root or under packages/ would have been staged.
.DS_Store

# Secrets
*.env
.env.*
